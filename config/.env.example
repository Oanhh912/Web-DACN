# ==============================================================================
# Bookora - Mẫu biến môi trường (.env.example)
# ==============================================================================
# SAO CHÉP file này thành:
#   - config/email_config.properties   (cho cấu hình email)
#   - config/sms_config.properties     (cho cấu hình SMS - tùy chọn)
#   - config/gemini.key                (cho Gemini AI API key)
#
# KHÔNG đặt thông tin thật vào file .env.example này.
# KHÔNG commit các file config thật lên Git.
# ==============================================================================

# ─── DATABASE (DBContext.java) ────────────────────────────────────────────────
# Mặc định đang hardcode trong DBContext.java. Để tùy chỉnh, sửa trực tiếp:
#   backend/src/main/java/com/bookstore/data/DBContext.java
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=web_bookora
DB_USER=root
DB_PASSWORD=

# ─── EMAIL / OTP Gmail SMTP ───────────────────────────────────────────────────
# Đặt vào: config/email_config.properties
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Bookora - Tiệm Sách Tri Thức

# Cách lấy App Password Gmail:
# 1. Vào https://myaccount.google.com/security
# 2. Bật 2-Step Verification
# 3. Vào https://myaccount.google.com/apppasswords
# 4. Tạo App Password với tên "Bookora"
# 5. Sao chép 16 ký tự vào EMAIL_APP_PASSWORD

# ─── SMS / OTP Twilio (tùy chọn) ─────────────────────────────────────────────
# Đặt vào: config/sms_config.properties
# Bỏ trống nếu không cần gửi OTP qua SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ─── GEMINI AI API KEY ────────────────────────────────────────────────────────
# Đặt vào: config/gemini.key
# Nội dung file chỉ chứa API key, không có gì khác
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_actual_api_key_here

# ─── SERVER ───────────────────────────────────────────────────────────────────
# Cổng mặc định: 8080
SERVER_PORT=8080
